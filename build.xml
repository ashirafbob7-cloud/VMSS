<?xml version="1.0" encoding="UTF-8"?>
<project name="vehicle-service-management-system" default="default" basedir=".">
    <description>Builds, tests, and runs the project vehicle-service-management-system.</description>
    <property file="nbproject/project.properties"/>
    
    <target name="default" depends="compile,run"/>
    
    <target name="init">
        <mkdir dir="target/classes"/>
        <mkdir dir="data"/>
    </target>
    
    <target name="compile" depends="init">
        <javac srcdir="src/main/java" destdir="target/classes" includeantruntime="false" source="17" target="17"/>
    </target>
    
    <target name="run" depends="compile">
        <java classname="com.vehicleservice.Main" fork="true">
            <classpath path="target/classes"/>
        </java>
    </target>
    
    <target name="clean">
        <delete dir="target/classes"/>
    </target>
</project>
